# Keep this file secret-free. The backend alone reads these settings.
FRAUD_AGENT_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4
# Per-stage model overrides. Each defaults to OPENAI_MODEL above when unset,
# so today's single-model configuration keeps working untouched. The analyst
# (app/analysis/analyst.py) is the only one a call is spent on today; the gate
# and verifier stages are expected to use a cheaper tier and a different tier
# respectively once they exist (agents/PLAN.md T7/T8).
FRAUD_AGENT_ANALYST_MODEL=
FRAUD_AGENT_GATE_MODEL=
FRAUD_AGENT_VERIFIER_MODEL=
# Hard cap on model calls per analysis run (see backend/app/analysis/pipeline.py).
FRAUD_AGENT_MODEL_CALL_CAP=500
# Worker threads for concurrent per-entry analysis. I/O-bound on HTTPS calls
# to the model provider, so this can exceed the machine's core count.
FRAUD_AGENT_MAX_WORKERS=12
