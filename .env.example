# Keep this file secret-free. The backend alone reads these settings.
FRAUD_AGENT_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4
# Hard cap on model calls per analysis run (see backend/app/analysis/graph_analyzer.py).
FRAUD_AGENT_MODEL_CALL_CAP=500
# Worker threads for concurrent process-graph traversal. I/O-bound on HTTPS
# calls to the model provider, so this can exceed the machine's core count.
FRAUD_AGENT_MAX_WORKERS=12
